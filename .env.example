# Database
POSTGRES_USER=smtprelay
POSTGRES_PASSWORD=changeme
POSTGRES_DB=smtprelay
DATABASE_URL=postgresql://smtprelay:changeme@localhost:5432/smtprelay

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
KEY_ENCRYPTION_SECRET=your-key-encryption-secret-change-in-production

# SMTP / Deliverability
DKIM_SELECTOR=mail
BOUNCE_EMAIL=bounce@yourdomain.com
TRACKING_DOMAIN=track.yourdomain.com

# TLS certificates for SMTP ports 465/587 (paths to PEM files)
SMTP_TLS_CERT=/certs/server.crt
SMTP_TLS_KEY=/certs/server.key

# App
NODE_ENV=development
PORT=3000

# Frontend
VITE_API_URL=http://localhost:3000
