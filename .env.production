# ── Server identity ───────────────────────────────────────────────
DOMAIN=mail.yourdomain.com          # hostname of this server (used for TLS cert path)
TRACKING_DOMAIN=mail.yourdomain.com # domain for open/click tracking pixels
BOUNCE_EMAIL=bounce@yourdomain.com  # address that receives bounce DSNs

# ── Database ──────────────────────────────────────────────────────
POSTGRES_USER=smtprelay
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=smtprelay

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING_64_CHARS

# ── DKIM ──────────────────────────────────────────────────────────
DKIM_SELECTOR=mail
